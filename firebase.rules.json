{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('meta/hostUid').val() === auth.uid && newData.child('members').child(auth.uid).exists()) || (data.exists() && !newData.exists() && data.child('meta/hostUid').val() === auth.uid))",
        ".validate": "!newData.exists() || (newData.hasChildren(['meta','state']) && newData.child('meta/hostUid').isString())",
        "meta": {
          "hostUid": {
            ".write": "auth != null && root.child('rooms').child($room).child('members').child(auth.uid).exists() && ((data.val() === auth.uid && root.child('rooms').child($room).child('members').child(newData.val()).exists()) || (!root.child('rooms').child($room).child('members').child(data.val()).exists() && newData.val() === auth.uid))",
            ".validate": "newData.isString()"
          },
          "updatedAt": {
            ".write": "auth != null && root.child('rooms').child($room).child('members').child(auth.uid).exists()"
          }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($room).exists()",
            ".validate": "!newData.exists() || (newData.hasChildren(['name','role','joinedAt','lastSeen']) && newData.child('name').isString() && newData.child('name').val().length <= 28 && (newData.child('role').val() === 'seeker' || newData.child('role').val() === 'hider') && (!data.exists() || newData.child('role').val() === data.child('role').val()))"
          }
        },
        "state": {
          "match": {
            ".write": "auth != null && root.child('rooms').child($room).child('meta/hostUid').val() === auth.uid"
          },
          "game": {
            ".write": "auth != null && root.child('rooms').child($room).child('members').child(auth.uid).exists() && (root.child('rooms').child($room).child('members').child(auth.uid).child('role').val() === 'seeker' || root.child('rooms').child($room).child('meta/hostUid').val() === auth.uid)"
          },
          "updatedAt": {
            ".write": "auth != null && root.child('rooms').child($room).child('members').child(auth.uid).exists()"
          },
          "updatedBy": {
            ".write": "auth != null && root.child('rooms').child($room).child('members').child(auth.uid).exists()",
            ".validate": "newData.val() === auth.uid"
          }
        }
      }
    }
  }
}
